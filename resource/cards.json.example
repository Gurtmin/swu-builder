    "localizations" : {
      "data" : [ {
        "id" : 50866,
        "attributes" : {
          "title" : "Anakin Skywalker",
          "subtitle" : "Proteggerla Ad Ogni Costo",
          "cardNumber" : 2,
          "cardCount" : 84,
          "artist" : "Reno",
          "artFrontHorizontal" : true,
          "artBackHorizontal" : null,
          "hasFoil" : true,
          "cost" : 5,
          "hp" : 5,
          "power" : 4,
          "text" : "Azione [Esaurire]: Se 2 o più unità amiche sono entrate in gioco in questa fase (incluse unità segnalino e leader), dai 1 segnalino Scudo a una di esse.",
          "textStyled" : "<p><strong>Azione [</strong><img src=\"https://ffg-prod-uploads.s3.amazonaws.com/icon_exhaust_0c450d09d4.png\" alt=\"icon_exhaust.png\"><strong>]:</strong> Se 2 o più unità amiche sono entrate in gioco in questa fase (incluse unità segnalino e leader), dai 1 segnalino Scudo a una di esse.</p>",
          "deployBox" : "Sentinella (Quando ti attaccano, le unità nemiche in questa arena devono attaccare un'unità con Sentinella.) \nQuando Attacca: Dai 1 segnalino Scudo a un'altra unità amica che è entrata in gioco in questa fase.",
          "deployBoxStyled" : "<p><strong>Sentinella </strong><i>(Quando ti attaccano, le unità nemiche in questa arena devono attaccare un'unità con Sentinella.) </i></p><p><strong>Quando Attacca</strong>: Dai 1 segnalino Scudo a un'altra unità amica che è entrata in gioco in questa fase.</p>",
          "epicAction" : "Azione Epica: Se controlli 5 \no più risorse, schiera questo leader.",
          "epicActionStyled" : "<p><strong>Azione Epica:</strong> Se controlli 5  o più risorse, schiera questo leader.</p>",
          "linkHtml" : "<a href=\"/cards?cid=4956378430\" class=\"card-tooltip\" data-card=\"4956378430\">Anakin Skywalker</a>",
