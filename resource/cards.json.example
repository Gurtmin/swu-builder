      }, {
        "id" : 50868,
        "attributes" : {
          "title" : "Maul",
          "subtitle" : "Gründer des Kollektivs",
          "cardNumber" : 3,
          "cardCount" : 84,
          "artist" : "David Buisán",
          "artFrontHorizontal" : true,
          "artBackHorizontal" : null,
          "hasFoil" : true,
          "cost" : 7,
          "hp" : 9,
          "power" : 5,
          "text" : "Aktion [Erschöpfe]: Wähle eine Einheit. Falls sie mehr unterschiedliche Schlüsselwörter als angehängte Erfahrung-Marker hat, gib ihr 1 Erfahrung-Marker und füge ihr 1 Schaden zu.",
          "textStyled" : "<p><strong>Aktion [</strong><img src=\"https://ffg-prod-uploads.s3.amazonaws.com/icon_exhaust_0c450d09d4.png\" alt=\"icon_exhaust.png\"><strong>]:</strong> Wähle eine Einheit. Falls sie mehr unterschiedliche <strong>Schlüsselwörter </strong>als angehängte Erfahrung-Marker hat, gib ihr 1 Erfahrung-Marker und füge ihr 1 Schaden zu.</p>",
          "deployBox" : "Wenn gerufen / Beim Angriff: Wähle eine Einheit. Falls sie mehr unterschiedliche Schlüsselwörter als angehängte Erfahrung-Marker hat, gib ihr 1 Erfahrung-Marker und füge ihr 1 Schaden zu.",
          "deployBoxStyled" : "<p><strong>Wenn gerufen / Beim Angriff:</strong> Wähle eine Einheit. Falls sie mehr unterschiedliche <strong>Schlüsselwörter</strong> als angehängte Erfahrung-Marker hat, gib ihr 1 Erfahrung-Marker und füge ihr 1 Schaden zu.</p>",
          "epicAction" : "Epische Aktion: Falls du 7 oder mehr Ressourcen kontrollierst, rufe diesen Anführer.",
          "epicActionStyled" : "<p><strong>Epische Aktion:</strong> Falls du 7 oder mehr Ressourcen kontrollierst, rufe diesen Anführer.</p>",
          "linkHtml" : "<a href=\"/cards?cid=0319685377\" class=\"card-tooltip\" data-card=\"0319685377\">Maul</a>",
