      }, {
        "id" : 50870,
        "attributes" : {
          "title" : "Maul",
          "subtitle" : "Ambition Collective",
          "cardNumber" : 3,
          "cardCount" : 84,
          "artist" : "David Buisán",
          "artFrontHorizontal" : true,
          "artBackHorizontal" : null,
          "hasFoil" : true,
          "cost" : 7,
          "hp" : 9,
          "power" : 5,
          "text" : "Action [Inclinez] : choisissez une unité. Si elle a plus de mots-clés différents que de jetons Expérience sur elle, donnez-lui un jeton Expérience et infligez-lui 1 dégât.",
          "textStyled" : "<p><strong>Action [</strong><img src=\"https://ffg-prod-uploads.s3.amazonaws.com/icon_exhaust_0c450d09d4.png\" alt=\"icon_exhaust.png\"><strong>] :</strong> choisissez une unité. Si elle a plus de <strong>mots-clés</strong> différents que de jetons Expérience sur elle, donnez-lui un jeton Expérience et infligez-lui 1 dégât.</p>",
          "deployBox" : "Une fois déployé/En attaque : choisissez une unité. Si elle a plus de mots-clés différents que de jetons Expérience sur elle, donnez-lui un jeton Expérience et infligez-lui 1 dégât.",
          "deployBoxStyled" : "<p><strong>Une fois déployé/En attaque :</strong> choisissez une unité. Si elle a plus de <strong>mots-clés</strong> différents que de jetons Expérience sur elle, donnez-lui un jeton Expérience et infligez-lui 1 dégât.</p>",
          "epicAction" : "Action Épique : si vous contrôlez au moins 7 ressources, déployez ce leader.",
          "epicActionStyled" : "<p><strong>Action Épique :</strong> si vous contrôlez au moins 7 ressources, déployez ce leader.</p>",
          "linkHtml" : "<a href=\"/cards?cid=0319685377\" class=\"card-tooltip\" data-card=\"0319685377\">Maul</a>",
