        "id" : 50861,
        "attributes" : {
          "title" : "Conte Dooku",
          "subtitle" : "Offre Aiuto",
          "cardNumber" : 1,
          "cardCount" : 84,
          "artist" : "Johnny Morrow",
          "artFrontHorizontal" : true,
          "artBackHorizontal" : null,
          "hasFoil" : true,
          "cost" : 7,
          "hp" : 7,
          "power" : 6,
          "text" : "Azione [Esaurire]: Scegli 2 giocatori. \nOgnuno di essi crea 1 segnalino \nDroide da Battaglia e cura \n1 danno alla propria base.",
          "textStyled" : "<p><strong>Azione [</strong><img src=\"https://ffg-prod-uploads.s3.amazonaws.com/icon_exhaust_0c450d09d4.png\" alt=\"icon_exhaust.png\"><strong>]:</strong> Scegli 2 giocatori.  Ognuno di essi crea 1 segnalino  Droide da Battaglia e cura  1 danno alla propria base.</p>",
          "deployBox" : "Recupero 2 (Quando questa unità attacca, cura 2 danni alla tua base.)\nQuando Attacca: Crea 2 segnalini Droide \nda Battaglia.",
          "deployBoxStyled" : "<p><strong>Recupero 2</strong> <i>(Quando questa unità attacca, c</i>u<i>ra 2 danni alla tua base.)</i></p><p><strong>Quando Attacca:</strong> Crea 2 segnalini Droide  da Battaglia.</p>",
          "epicAction" : "Azione Epica: Se controlli 7 \no più risorse, schiera questo leader.",
          "epicActionStyled" : "<p><strong>Azione Epica:</strong> Se controlli 7  o più risorse, schiera questo leader.</p>",
          "linkHtml" : "<a href=\"/cards?cid=7416439679\" class=\"card-tooltip\" data-card=\"7416439679\">Conte Dooku</a>",
