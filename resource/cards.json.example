    "localizations" : {
      "data" : [ {
        "id" : 50871,
        "attributes" : {
          "title" : "Maul",
          "subtitle" : "Ambizioni Del Collettivo",
          "cardNumber" : 3,
          "cardCount" : 84,
          "artist" : "David Buisán",
          "artFrontHorizontal" : true,
          "artBackHorizontal" : null,
          "hasFoil" : true,
          "cost" : 7,
          "hp" : 9,
          "power" : 5,
          "text" : "Azione [Esaurire]: Scegli 1 unità. Se ha più parole chiave diverse che segnalini Esperienza su di essa, dalle 1 segnalino Esperienza e infliggile 1 danno.",
          "textStyled" : "<p><strong>Azione [</strong><img src=\"https://ffg-prod-uploads.s3.amazonaws.com/icon_exhaust_0c450d09d4.png\" alt=\"icon_exhaust.png\"><strong>]:</strong> Scegli 1 unità. Se ha più parole chiave diverse che segnalini Esperienza su di essa, dalle 1 segnalino Esperienza e infliggile 1 danno.</p>",
          "deployBox" : "Quando Schierata/Quando Attacca: \nScegli 1 unità. Se ha più parole chiave diverse che segnalini Esperienza su di essa, dalle \n1 segnalino Esperienza e infliggile 1 danno.",
          "deployBoxStyled" : "<p><strong>Quando Schierata/Quando Attacca:</strong>  Scegli 1 unità. Se ha più parole chiave diverse che segnalini Esperienza su di essa, dalle  1 segnalino Esperienza e infliggile 1 danno.</p>",
          "epicAction" : "Azione Epica: Se controlli 7 \no più risorse, schiera questo leader.",
          "epicActionStyled" : "<p><strong>Azione Epica:</strong> Se controlli 7  o più risorse, schiera questo leader.</p>",
          "linkHtml" : "<a href=\"/cards?cid=0319685377\" class=\"card-tooltip\" data-card=\"0319685377\">Maul</a>",
          "cardId" : null,
          "createdAt" : "2026-02-10T20:58:57.684Z",
