}, {
  "id" : 50862,
  "attributes" : {
    "cardNumber" : 2,
    "title" : "Anakin Skywalker",
    "subtitle" : "Protect Her At All Costs",
    "cardCount" : 84,
    "artist" : "Reno",
    "artFrontHorizontal" : true,
    "artBackHorizontal" : null,
    "hasFoil" : true,
    "cost" : 5,
    "hp" : 5,
    "power" : 4,
    "text" : "Action [Exhaust]: If 2 or more friendly units entered play this phase (including tokens and leaders), give a Shield token to 1 of them.",
    "textStyled" : "<p><strong>Action [</strong><img src=\"https://ffg-prod-uploads.s3.amazonaws.com/icon_exhaust_0c450d09d4.png\" alt=\"icon_exhaust.png\"><strong>]:</strong> If 2 or more friendly units entered play this phase <i>(including tokens and leaders)</i>, give a Shield token to 1 of them.</p>",
    "deployBox" : "Sentinel (Enemy units in this arena must attack a Sentinel when they attack you.)\nOn Attack: Give a Shield token to another friendly unit that entered play this phase.",
    "deployBoxStyled" : "<p><strong>Sentinel </strong><i>(Enemy units in this arena must attack a Sentinel when they attack you.)</i></p><p><strong>On Attack</strong>: Give a Shield token to another friendly unit that entered play this phase.</p>",
    "epicAction" : "Epic Action: If you control 5 or more resources, deploy this leader.",
    "epicActionStyled" : "<p><strong>Epic Action:</strong> If you control 5 or more resources, deploy this leader.</p>",
